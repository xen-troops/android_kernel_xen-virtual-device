        ":xen_virtual_device_aarch64",
        ":xen_virtual_device_aarch64_merged_kernel_uapi_headers",
        ":xen_virtual_device_aarch64_modules_install",
    ],
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//visibility:private"],
)

pkg_install(
