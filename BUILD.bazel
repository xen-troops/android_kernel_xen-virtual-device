kernel_build(
    name = "xen_virtual_device_aarch64",
    srcs = [":xen_virtual_device_aarch64_common_sources"],
    defconfig = "//common:arch/arm64/configs/gki_defconfig",
    check_defconfig = "disabled",
    outs = [
        "System.map",
        "arch/arm64/boot/Image",
        ".config",
    ],
    make_goals = [
        "Image",
        "modules",
    ],
    makefile = "//common:Makefile",
    module_outs = _VIRT_COMMON_MODULES + _VIRT_AARCH64_MODULES,
    module_implicit_outs = _IMPLICIT_MODULES,
    strip_modules = True,
    defconfig_fragments = [
        "virtual_device_core.fragment",
        "virtual_device.fragment",
        "aarch64.fragment",
        "xenvm.aarch64.fragment",
    ],
    visibility = [
        "//modules:__subpackages__",
        "//common-modules:__subpackages__",
    ],
)

kernel_module_group(
    name = "xen_virtual_device_aarch64_external_modules",
    srcs = [
        "//common-modules/xen-virtual-device/dma_buf_cma_heap:dma_buf_cma_heap",
        "//modules/imagination/ddk/rogue_km:pvrsrvkm",
        "//modules/renesas/disfwk_fe:disfwk_fe",
        "//modules/renesas/rcar-mfis:rcar_mfis",
        "//modules/renesas/rcar_gen5_rproc:rcar_gen5_rproc",
        "//modules/renesas/camfwk_fe:camfwk_fe",
    ],
)

merged_kernel_uapi_headers(
    name = "xen_virtual_device_aarch64_merged_kernel_uapi_headers",
    kernel_build = ":xen_virtual_device_aarch64",
    kernel_modules = [
        ":xen_virtual_device_aarch64_external_modules",
    ],
)

kernel_modules_install(
    name = "xen_virtual_device_aarch64_modules_install",
    kernel_build = ":xen_virtual_device_aarch64",
    kernel_modules = [
        ":xen_virtual_device_aarch64_external_modules",
    ],
)

pkg_files(
    name = "xen_virtual_device_aarch64_dist_files",
