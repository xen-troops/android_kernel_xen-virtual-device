# Drivers used by all Android virtual devices
CONFIG_BATTERY_GOLDFISH=m
CONFIG_BT_HCIVHCI=m
CONFIG_BT_HCIUART=m
CONFIG_CPUFREQ_DUMMY=m
CONFIG_DMABUF_HEAPS_SYSTEM=m
CONFIG_MAC80211_HWSIM=m
CONFIG_RTC_DRV_TEST=m
CONFIG_USB_DUMMY_HCD=m
CONFIG_VIRTIO_PMEM=m # nocheck: LIBNVDIMM depends on PHYS_ADDR_T_64BIT, so disabled on 32-bit
CONFIG_USBIP_CORE=m
CONFIG_USBIP_VHCI_HCD=m
CONFIG_CFG80211=m
CONFIG_NL80211_TESTMODE=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_REG_CELLULAR_HINTS=y
CONFIG_MAC80211=m

# Drivers to run specific sanity tests
CONFIG_TEST_MEMINIT=m # nocheck: RUNTIME_TESTING_MENU not enabled in aarch64

# Cuttlefish-specific drivers
CONFIG_VIRT_WIFI=m

# Auto-specific drivers
CONFIG_BT_HCIBTUSB=m
CONFIG_CAN_GS_USB=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_SND_DRIVERS=y
CONFIG_SND_ALOOP=m

# TV-specific drivers
CONFIG_USB_PULSE8_CEC=m

# Vivid V4L2-test module
CONFIG_MEDIA_TEST_SUPPORT=y
CONFIG_V4L_TEST_DRIVERS=y
CONFIG_VIDEO_VIVID=m
